    "import gradio as gr\n",
    "\n",
    "def transcribe_audio(audio_path):\n",
    "    if audio_path is None:\n",
    "        return \"No audio received.\"\n",
    "    audio, sr = librosa.load(audio_path, sr=16000)\n",
    "    input_features = processor(audio, sampling_rate=16000, return_tensors=\"pt\").input_features.to(\"cuda\")\n",
    "    with torch.no_grad():\n",
    "        pred_ids = model.generate(input_features)\n",
    "        text = processor.batch_decode(pred_ids, skip_special_tokens=True)[0]\n",
    "    return normalizer.normalize(text, for_asr=False)\n",
    "\n",
    "demo = gr.Interface(\n",
    "    fn=transcribe_audio,\n",
    "    inputs=gr.Audio(type=\"filepath\"),\n",
    "    outputs=gr.Textbox(label=\"Dagbani Transcription (BGL 1998 Standard)\"),\n",
    "    title=\"🎙️ Dagbani Whisper ASR — Live Demo\",\n",
    "    description=\"Speak or upload Dagbani audio to generate instant, orthographically standardized Dagbani transcriptions.\"\n",
    ")\n",
    "\n",
    "# Launch inline in Kaggle\n",
