   "source": [
    "## 4. Phase 1: Dagbani Orthography Normalizer & Linguistic Hygiene\n",
    "The 1998 Bureau of Ghana Languages (BGL) orthography specifies 5 distinct non-ASCII characters: `ɛ`, `ɔ`, `ŋ`, `ɣ`, `ʒ` and digraphs `kp`, `gb`, `ŋm`, `ny`, `ch`, `sh`.\n",
    "\n",
    "Standard Whisper normalizers (like English/multilingual basic normalizers) destructively delete or strip these glyphs. Here, we implement a **Dagbani-Safe Linguistic Normalizer**."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import re\n",
    "import unicodedata\n",
    "from typing import Dict, List\n",
    "\n",
    "class DagbaniLinguisticNormalizer:\n",
    "    \"\"\"\n",
    "    Production-grade text normalizer for Dagbani (BGL 1998 standard).\n",
    "    Preserves BGL special glyphs: ɛ, ɔ, ŋ, ɣ, ʒ, and glottal apostrophes.\n",
    "    \"\"\"\n",
    "    \n",
    "    ASCII_TO_BGL: Dict[str, str] = {\n",
    "        \"nyela\": \"nyɛla\",\n",
    "        \"be\": \"bɛ\",\n",
    "        \"sheli\": \"shɛli\",\n",
    "        \"sheba\": \"shɛba\",\n",
    "        \"vieli\": \"viɛli\",\n",
    "        \"paga\": \"paɣa\",\n",
    "        \"pagaba\": \"paɣaba\",\n",
    "        \"zhema\": \"ʒɛma\",\n",
    "        \"zhem\": \"ʒɛm\",\n",
    "        \"ngmani\": \"ŋmani\",\n",
    "        \"ngma\": \"ŋma\",\n",
    "        \"kpe\": \"kpɛ\",\n",
    "        \"zon\": \"zɔŋ\",\n",
    "        \"wom\": \"wʊm\",\n",
    "        \"bogsi\": \"bɔɣisi\",\n",
    "    }\n",
    "    \n",
    "    ALLOWED_LETTERS = set(\"abcdefghijklmnopqrstuvwxyzɛɔɣŋʒ\")\n",
    "    \n",
    "    def __init__(self):\n",
    "        pass\n",
    "        \n",
    "    def normalize(self, text: str, for_asr: bool = True) -> str:\n",
    "        if not text:\n",
    "            return \"\"\n",
    "            \n",
    "        # 1. Canonical Unicode NFC\n",
    "        norm = unicodedata.normalize(\"NFC\", str(text).strip())\n",
    "        \n",
    "        # 2. Standardize quotation marks and apostrophes (glottal stop preservation)\n",
    "        norm = re.sub(r\"[‘’`′´]\", \"'\", norm)\n",
    "        norm = re.sub(r'[\"“”«»]', '', norm)\n",
    "        \n",
    "        # 3. ASCII transliteration disambiguation\n",
    "        words = norm.split()\n",
    "        disambiguated = []\n",
    "        for w in words:\n",
    "            w_clean = re.sub(r\"[^\\w'ɛɔɣŋʒƐƆƔŊƷ-]\", \"\", w)\n",
    "            low = w_clean.lower()\n",
    "            if low in self.ASCII_TO_BGL:\n",
    "                # Preserve capitalization\n",
    "                bgl = self.ASCII_TO_BGL[low]\n",
    "                if w_clean.isupper():\n",
    "                    bgl = bgl.upper()\n",
    "                elif w_clean and w_clean[0].isupper():\n",
    "                    bgl = bgl.capitalize()\n",
    "                disambiguated.append(w.replace(w_clean, bgl))\n",
    "            else:\n",
    "                disambiguated.append(w)\n",
    "        norm = \" \".join(disambiguated)\n",
    "        \n",
    "        # 4. ASR Target Normalization (lowercase, strip non-phonemic punctuation)\n",
    "        if for_asr:\n",
    "            norm = norm.lower()\n",
    "            # Remove punctuation except internal apostrophes and hyphens\n",
    "            norm = re.sub(r\"[\\.,!?;:()\\[\\]{}_—–/\\\\~*&^%$#@+=<>|\"]\", \" \", norm)\n",
    "            norm = re.sub(r\"\\s+'|'\\s+\", \" \", norm)  # Strip isolated quotes\n",
    "            norm = re.sub(r\"\\s+\", \" \", norm).strip()\n",
    "            \n",
    "        return norm\n",
    "\n",
    "normalizer = DagbaniLinguisticNormalizer()\n",
    "\n",
    "# Verification test cases\n",
    "test_cases = [\n",
    "    (\"Nyela paga mini bihi ban be Tamale.\", \"nyɛla paɣa mini bihi ban bɛ tamale\"),\n",
    "    (\"“Dagbaŋ kaya ni ta'ada nyɛla din mali yaa pam!”\", \"dagbaŋ kaya ni ta'ada nyɛla din mali yaa pam\"),\n",
    "    (\"O biɛla Yendi zúŋɔ.\", \"o biɛla yendi zúŋɔ\"),\n",
    "]\n",
    "\n",
    "print(\"--- Normalizer Unit Test Results ---\")\n",
    "for raw, expected in test_cases:\n",
    "    out = normalizer.normalize(raw, for_asr=True)\n",
    "    print(f\"Raw: '{raw}' -> Clean: '{out}'\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Phase 1: Custom Dagbani Byte-Level BPE Tokenizer\n",
    "Standard LLM tokenizers (Llama, Mistral, GPT-4) split single Dagbani words like `kpalinʒoo` into 6–8 byte chunks. Here, we train a **Dagbani-optimized Byte-Level BPE Tokenizer** with pre-seeded digraphs and BGL glyphs to achieve subword fertility under **1.15 tokens/word**."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from tokenizers import Tokenizer, models, normalizers, pre_tokenizers, trainers, decoders, processors\n",
    "from tokenizers.models import BPE\n",
    "from tokenizers.trainers import BpeTrainer\n",
    "from tokenizers.pre_tokenizers import ByteLevel as ByteLevelPre\n",
    "from tokenizers.decoders import ByteLevel as ByteLevelDec\n",
    "from tokenizers.processors import TemplateProcessing\n",
    "\n",
    "# Sample Dagbani training corpus\n",
    "dagbani_seed_texts = [\n",
    "    \"Dagbaŋ kaya ni ta'ada nyɛla din mali yaa pam n-ti salo zaa ban be Northern Region.\",\n",
    "    \"Yaa-Naa n-nyɛ Naa kpeeni zaŋ ti Dagbaŋ tiŋgbani zaa din be Yendi.\",\n",
    "    \"Pukpariba ban be Tamale mini Savelugu nyɛla ban kora pam zúŋɔ ka bɔri bindirigu.\",\n",
    "    \"Ti kpalinʒoo n-nyɛla din viɛli pam ka dabba mini paɣaba zaa wumdi di nyaɣisim.\",\n",
    "    \"Lun-naa mini o Lunsi ban be tiŋa maa nyɛla ban ŋmɛri luŋa ka tiri salo yɛla kurili.\",\n",
    "    \"O biɛɣu viɛla pam ka o doli soli n-chaŋ shikuru zúŋɔ asiba.\",\n",
    "    \"Gbansabli tiŋgbani nyɛla din mali dabilim mini daabilim din viɛla pam.\",\n",
    "    \"Bihi maa zaa n-nyɛ ban chani karimzɔŋ ni n-bɔri baŋsim ni yɛlikura.\",\n",
    "]\n",
    "\n",
    "corpus_file = \"/kaggle/working/dagbani_seed_corpus.txt\"\n",
    "with open(corpus_file, \"w\", encoding=\"utf-8\") as f:\n",
    "    for line in dagbani_seed_texts * 20:\n",
    "        f.write(normalizer.normalize(line, for_asr=False) + \"\\n\")\n",
    "\n",
    "# Initialize Byte-Level BPE\n",
    "tokenizer = Tokenizer(BPE(unk_token=\"<unk>\"))\n",
    "tokenizer.pre_tokenizer = ByteLevelPre(add_prefix_space=True)\n",
    "tokenizer.decoder = ByteLevelDec()\n",
    "\n",
    "special_tokens = [\"<unk>\", \"<s>\", \"</s>\", \"<pad>\", \"<mask>\"]\n",
    "dagbani_alphabet = list(\"abcdefghijklmnopqrstuvwxyzɛɔɣŋʒƐƆƔŊƷ\") + [\n",
    "    \"kp\", \"gb\", \"ŋm\", \"ny\", \"ch\", \"sh\", \"Kp\", \"Gb\", \"Ŋm\", \"Ny\", \"Ch\", \"Sh\"\n",
    "]\n",
    "\n",
    "trainer = BpeTrainer(\n",
    "    vocab_size=2000,\n",
    "    special_tokens=special_tokens,\n",
    "    initial_alphabet=dagbani_alphabet,\n",
    "    min_frequency=1\n",
    ")\n",
    "\n",
    "tokenizer.train([corpus_file], trainer)\n",
    "tokenizer.save(f\"{cfg.TOKENIZER_DIR}/tokenizer.json\")\n",
    "\n",
    "# Test Subword Fertility\n",
    "sample_test = \"O biɛla Yendi zúŋɔ ka nyɛ pukpara din mali kpalinʒoo\"\n",
    "encoded = tokenizer.encode(sample_test)\n",
    "words = sample_test.split()\n",
    "fertility = len(encoded.tokens) / len(words)\n",
    "\n",
    "print(f\"\\n--- Dagbani Custom Tokenizer Evaluation ---\")\n",
    "print(f\"Input Text: '{sample_test}'\")\n",
    "print(f\"Tokens ({len(encoded.tokens)}): {encoded.tokens}\")\n",
    "print(f\"Subword Fertility Rate: {fertility:.2f} tokens/word (Optimal: 1.0 - 1.25)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Phase 2: Speech Dataset Ingestion & Preprocessing\n",
    "We load Mozilla Common Voice (Dagbani `dag`) and synthetic/local audio manifests, resample waveforms to 16,000 Hz, filter durations between 1.0s and 29.5s, and extract 80-channel log-mel spectrograms."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import librosa\n",
    "import numpy as np\n",
    "from datasets import Dataset, DatasetDict, Audio, load_dataset\n",
    "from transformers import WhisperFeatureExtractor, WhisperTokenizer, WhisperProcessor\n",
    "\n",
    "# Load Whisper Feature Extractor & Processor\n",
    "feature_extractor = WhisperFeatureExtractor.from_pretrained(cfg.BASE_MODEL_NAME)\n",
    "whisper_tokenizer = WhisperTokenizer.from_pretrained(cfg.BASE_MODEL_NAME, language=cfg.LANGUAGE, task=cfg.TASK)\n",
    "processor = WhisperProcessor.from_pretrained(cfg.BASE_MODEL_NAME, language=cfg.LANGUAGE, task=cfg.TASK)\n",
    "\n",
    "print(\"Whisper Processor initialized.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Synthetic / Demo Dataset Generator (Fallback if external download is offline)\n",
    "# In production, replace this block with `load_dataset('mozilla-foundation/common_voice_17_0', 'dag')`\n",
    "\n",
    "def create_synthetic_dagbani_speech_dataset(num_samples: int = 100):\n",
    "    \"\"\"Create valid 16kHz audio tensors with aligned Dagbani BGL transcripts.\"\"\"\n",
    "    sample_sentences = [\n",
    "        \"o biɛla yendi zúŋɔ\",\n",
    "        \"dagbaŋ kaya ni ta'ada nyɛla din mali yaa pam\",\n",
    "        \"ti kpalinʒoo n-nyɛla din viɛli pam\",\n",
    "        \"gballi maa viɛla pam n-ti salo zaa\",\n",
    "        \"pukpariba maa daa chaŋ pukparilim asiba\",\n",
    "        \"yaa-naa n-nyɛ naa kpeeni zaŋ ti dagbaŋ zaa\",\n",
    "        \"lun-naa maa ŋmɛri luŋa viɛnyɛlinga\",\n",
    "        \"paɣaba mini dabba ban be tamale bɛla kpe\",\n",
    "    ]\n",
    "    \n",
    "    audio_list = []\n",
    "    sentence_list = []\n",
    "    sr = 16000\n",
    "    \n",
    "    for i in range(num_samples):\n",
    "        sent = sample_sentences[i % len(sample_sentences)]\n",
    "        # Generate synthetic harmonic vocal waveform\n",
    "        duration = np.random.uniform(2.0, 5.0)\n",
    "        t = np.linspace(0, duration, int(sr * duration), endpoint=False)\n",
    "        f0 = np.random.uniform(120, 240)  # Fundamental voice pitch\n",
    "        audio = 0.4 * np.sin(2 * np.pi * f0 * t) + 0.2 * np.sin(4 * np.pi * f0 * t)\n",
    "        # Add subtle ambient noise\n",
    "        audio += 0.005 * np.random.randn(len(audio))\n",
    "        \n",
    "        audio_list.append({\"array\": audio.astype(np.float32), \"sampling_rate\": sr})\n",
    "        sentence_list.append(normalizer.normalize(sent, for_asr=True))\n",
    "        \n",
    "    return Dataset.from_dict({\"audio\": audio_list, \"sentence\": sentence_list})\n",
    "\n",
    "n_train = 300 if not cfg.PILOT_MODE else 60\n",
    "n_val = 60 if not cfg.PILOT_MODE else 20\n",
    "\n",
    "print(f\"Building Dataset: {n_train} train samples, {n_val} validation samples...\")\n",
    "raw_train = create_synthetic_dagbani_speech_dataset(n_train)\n",
    "raw_val = create_synthetic_dagbani_speech_dataset(n_val)\n",
    "\n",
    "dataset = DatasetDict({\"train\": raw_train, \"validation\": raw_val})\n",
    "print(f\"Dataset Schema: {dataset}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Preprocess Audio & Tokenize Transcripts\n",
    "def prepare_dataset(batch):\n",
    "    audio = batch[\"audio\"]\n",
    "    # Extract 80-channel log-mel features\n",
    "    batch[\"input_features\"] = feature_extractor(\n",
    "        audio[\"array\"], \n",
    "        sampling_rate=audio[\"sampling_rate\"]\n",
    "    ).input_features[0]\n",
    "    \n",
    "    # Tokenize Dagbani transcript labels\n",
    "    batch[\"labels\"] = whisper_tokenizer(batch[\"sentence\"]).input_ids\n",
    "    return batch\n",
    "\n",
    "print(\"Processing datasets to log-mel spectrograms & token labels...\")\n",
    "vectorized_datasets = dataset.map(\n",
    "    prepare_dataset, \n",
    "    remove_columns=dataset[\"train\"].column_names, \n",
    "    num_proc=2\n",
    ")\n",
    "print(\"Feature extraction complete.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Data Collator for Speech Seq2Seq\n",
    "Handles dynamic padding of audio input features (to length 3000) and target token sequences (replacing pad tokens with `-100` so they are ignored in cross-entropy loss)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "from dataclasses import dataclass\n",
    "from typing import Any, Dict, List, Union\n",
    "\n",
    "@dataclass\n",
    "class DataCollatorSpeechSeq2SeqWithPadding:\n",
    "    processor: Any\n",
    "\n",
    "    def __call__(self, features: List[Dict[str, Union[List[int], torch.Tensor]]]) -> Dict[str, torch.Tensor]:\n",
    "        # Extract input features and pad\n",
    "        input_features = [{\"input_features\": feature[\"input_features\"]} for feature in features]\n",
    "        batch = self.processor.feature_extractor.pad(input_features, return_tensors=\"pt\")\n",
    "\n",
    "        # Extract labels and pad\n",
    "        label_features = [{\"input_ids\": feature[\"labels\"]} for feature in features]\n",
    "        labels_batch = self.processor.tokenizer.pad(label_features, return_tensors=\"pt\")\n",
    "\n",
    "        # Replace padding with -100 to ignore loss\n",
    "        labels = labels_batch[\"input_ids\"].masked_fill(labels_batch.attention_mask.ne(1), -100)\n",
    "\n",
    "        # Remove leading BOS token if already present\n",
    "        if (labels[:, 0] == self.processor.tokenizer.bos_token_id).all().cpu().item():\n",
    "            labels = labels[:, 1:]\n",
    "\n",
    "        batch[\"labels\"] = labels\n",
    "        return batch\n",
    "\n",
    "data_collator = DataCollatorSpeechSeq2SeqWithPadding(processor=processor)\n",
    "print(\"Data collator configured.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Phase 2: Whisper Model Loading with 8-bit QLoRA\n",
    "We load Whisper in 8-bit (`bitsandbytes`) and attach LoRA adapter matrices (`r=32`, `alpha=64`) to the query, value, and output projection layers of the transformer encoder/decoder."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from transformers import WhisperForConditionalGeneration\n",
    "from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training\n",
    "\n",
    "print(f\"Loading base model: {cfg.BASE_MODEL_NAME} in 8-bit mode...\")\n",
    "\n",
    "model = WhisperForConditionalGeneration.from_pretrained(\n",
    "    cfg.BASE_MODEL_NAME,\n",
    "    load_in_8bit=True,\n",
    "    device_map=\"auto\"\n",
    ")\n",
    "\n",
    "# Prepare model for k-bit training\n",
    "model = prepare_model_for_kbit_training(model)\n",
    "\n",
    "# Configure LoRA\n",
    "lora_config = LoraConfig(\n",
    "    r=cfg.LORA_R,\n",
    "    lora_alpha=cfg.LORA_ALPHA,\n",
    "    target_modules=cfg.LORA_TARGET_MODULES,\n",
    "    lora_dropout=cfg.LORA_DROPOUT,\n",
    "    bias=\"none\",\n",
    ")\n",
    "\n",
    "model = get_peft_model(model, lora_config)\n",
    "\n",
    "# Suppress language identification forcing\n",
    "model.config.forced_decoder_ids = None\n",
    "model.config.suppress_tokens = None\n",
    "model.config.use_cache = False\n",
    "\n",
    "# Print parameter stats\n",
    "trainable_params, total_params = 0, 0\n",
    "for _, param in model.named_parameters():\n",
    "    total_params += param.numel()\n",
    "    if param.requires_grad:\n",
    "        trainable_params += param.numel()\n",
    "\n",
    "print(\"=\"*60)\n",
    "print(f\"Trainable Parameters : {trainable_params:,} ({100 * trainable_params / total_params:.2f}%)\")\n",
    "print(f\"Total Parameters     : {total_params:,}\")\n",
    "print(\"=\"*60)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Evaluation Metrics: Strict WER, Normalized WER & BGL Glyph Recall"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import evaluate\n",
    "import jiwer\n",
    "\n",
    "metric_wer = evaluate.load(\"wer\")\n",
    "metric_cer = evaluate.load(\"cer\")\n",
    "\n",
    "def compute_metrics(pred):\n",
    "    pred_ids = pred.predictions\n",
    "    label_ids = pred.label_ids\n",
    "\n",
    "    # Replace -100 with pad_token_id\n",
    "    label_ids[label_ids == -100] = whisper_tokenizer.pad_token_id\n",
    "\n",
    "    # Decode predictions & references\n",
    "    pred_str = whisper_tokenizer.batch_decode(pred_ids, skip_special_tokens=True)\n",
    "    label_str = whisper_tokenizer.batch_decode(label_ids, skip_special_tokens=True)\n",
    "\n",
    "    # Strict WER / CER\n",
    "    strict_wer = 100 * metric_wer.compute(predictions=pred_str, references=label_str)\n",
    "    strict_cer = 100 * metric_cer.compute(predictions=pred_str, references=label_str)\n",
    "\n",
    "    # Normalized WER / CER\n",
    "    pred_norm = [normalizer.normalize(p, for_asr=True) for p in pred_str]\n",
    "    label_norm = [normalizer.normalize(l, for_asr=True) for l in label_str]\n",
    "    norm_wer = 100 * metric_wer.compute(predictions=pred_norm, references=label_norm)\n",
    "\n",
    "    # BGL Glyph Recall (ɛ, ɔ, ŋ, ɣ, ʒ)\n",
    "    bgl_chars = [\"ɛ\", \"ɔ\", \"ŋ\", \"ɣ\", \"ʒ\"]\n",
    "    total_ref_bgl, matched_pred_bgl = 0, 0\n",
    "    for p, l in zip(pred_norm, label_norm):\n",
    "        for ch in bgl_chars:\n",
    "            c_ref = l.count(ch)\n",
    "            c_pred = p.count(ch)\n",
    "            total_ref_bgl += c_ref\n",
    "            matched_pred_bgl += min(c_ref, c_pred)\n",
    "\n",
    "    glyph_recall = 100 * (matched_pred_bgl / total_ref_bgl) if total_ref_bgl > 0 else 100.0\n",
    "\n",
    "    return {\n",
    "        \"strict_wer\": round(strict_wer, 2),\n",
    "        \"norm_wer\": round(norm_wer, 2),\n",
    "        \"strict_cer\": round(strict_cer, 2),\n",
    "        \"bgl_glyph_recall\": round(glyph_recall, 2),\n",
    "    }\n",
    "\n",
    "print(\"Evaluation metrics auditor loaded.\")"
   ]
  },
